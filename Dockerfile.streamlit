FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-ui.txt .
RUN pip install --no-cache-dir -r requirements-ui.txt

COPY ui_streamlit.py .
COPY presenters.py .
COPY usecase_generate.py .
COPY infra_api.py .
COPY history_repo.py .

CMD ["sh", "-c", "streamlit run ui_streamlit.py --server.address 0.0.0.0 --server.port ${PORT:-8501}"]
