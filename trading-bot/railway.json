{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "trading-bot/Dockerfile"
  },
  "deploy": {
    "startCommand": "python -u paper_trader.py --interval 14400",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
