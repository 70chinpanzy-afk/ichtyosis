{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "trading-bot/Dockerfile"
  },
  "deploy": {
    "startCommand": "python -u bot_v2.py --interval 3600",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
