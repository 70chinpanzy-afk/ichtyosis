# OpenAI API（必須）
OPENAI_API_KEY=sk-proj-...

# キュレーション設定
CURATOR_OPENAI_MODEL=gpt-4o
CURATOR_DB_PATH=ichthyosis_curator.db
CURATOR_MAX_ARTICLES_PER_RUN=20
CURATOR_PUBMED_EMAIL=your_email@example.com
CURATOR_LOG_LEVEL=INFO

# LINE Messaging API（オプション：設定するとLINE通知が有効になります）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# APIサーバー設定
CURATOR_API_HOST=0.0.0.0
CURATOR_API_PORT=8001
CURATOR_API_SECRET=
FRONTEND_URL=http://localhost:3000
